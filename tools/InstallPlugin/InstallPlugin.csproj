<Project Sdk="Microsoft.NET.Sdk">

  <!-- Installs a built plugin into a launcher folder the way the "Add plugin"  -->
  <!-- button does, so a test install can be prepared without clicking through -->
  <!-- the consent dialog on every rebuild. Development only; never shipped.  -->
  

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>InstallPlugin</AssemblyName>
    <RootNamespace>LauncherV2.Tools.InstallPlugin</RootNamespace>

    <!-- The launcher publishes self-contained, and a self-contained exe can    -->
    <!-- only be referenced by another one (NETSDK1151). Matching it also means  -->
    <!-- this gate runs against the same runtime the players get.                -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Multiworld-Launcher\LauncherV2.csproj" />
  </ItemGroup>

</Project>
