<Project Sdk="Microsoft.NET.Sdk">

  <!-- The 3DS, through Azahar. London reads no memory: the worlds ship their -->
  <!-- own client, which speaks Azahar's scripting protocol. See the .cs.     -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CatalogAzaharRunner</AssemblyName>
    <RootNamespace>LauncherV2.Extensions.Azahar</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.1.2</Version>
    <Company>Solida Games</Company>
    <Product>Azahar (3DS) runner extension for Multiworld Launcher</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Multiworld-Launcher\LauncherV2.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="extension.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
