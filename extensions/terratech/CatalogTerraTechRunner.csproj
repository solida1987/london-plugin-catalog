<Project Sdk="Microsoft.NET.Sdk">

  <!-- TerraTech as an installable extension. Not an emulator and not a port  -->
  <!-- the player downloads: it is a game they already own, so this runner    -->
  <!-- finds it, installs our mod into it, and starts it.                     -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CatalogTerraTechRunner</AssemblyName>
    <RootNamespace>LauncherV2.Extensions.TerraTech</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.1.0</Version>
    <Company>Solida Games</Company>
    <Product>TerraTech runner extension for Multiworld Launcher</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the launcher already has IEmulatorBridge loaded, and a
         second copy here would make the interface in this assembly a DIFFERENT
         type from the host's, so BridgeRegistry's cast would fail on a type
         that visibly implements it. -->
    <ProjectReference Include="..\..\..\Multiworld-Launcher\LauncherV2.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="extension.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The mod travels inside the extension, so installing the extension is
         the only download the player makes. -->
    <Content Include="TerraTechArchipelago.zip" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('TerraTechArchipelago.zip')" />
  </ItemGroup>

</Project>
